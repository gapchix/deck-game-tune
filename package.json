{
  "name": "deck-game-tune",
  "version": "0.0.1",
  "description": "Apply community-proven Steam Deck game settings in one tap",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gapchix/deck-game-tune.git"
  },
  "keywords": [
    "decky",
    "decky-plugin",
    "steam-deck",
    "steamos",
    "deck"
  ],
  "author": "gapchix",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gapchix/deck-game-tune/issues"
  },
  "homepage": "https://github.com/gapchix/deck-game-tune#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@eslint/js": "^9.13.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
